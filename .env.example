# Copy this file to .env and fill in the values. .env is in .gitignore and is never committed.
# Airtable personal access token for this app (create at https://airtable.com/create/tokens)
AIRTABLE_TOKEN=your-token-here
# ID of the "Kivo" base (starts with "app", copy it from the base URL)
AIRTABLE_BASE_ID=your-base-id-here
